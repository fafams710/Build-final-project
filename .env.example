# Copy to .env and fill in real values. Never commit .env.

# Your Finnhub API key (free tier): https://finnhub.io
FINNHUB_API_KEY=
# Shared secret required for every /api/* call (X-API-Key header) and /ws (?key=).
# The backend refuses to start if it is empty.
# Generate one: python -c "import secrets; print(secrets.token_urlsafe(32))"
APP_API_KEY=
# 127.0.0.1, not localhost (localhost may resolve to IPv6 first). A local Postgres install
# is usually on port 5432; the docker compose Postgres is published on host port 5433.
DATABASE_URL=postgresql://postgres:your_db_password@127.0.0.1:5432/ticks
FINNHUB_WS_URL=wss://ws.finnhub.io
# The dashboard must be opened at an origin listed here (the browser websocket is
# refused otherwise), e.g. http://localhost:5173, not http://127.0.0.1:5173.
CORS_ORIGINS=http://localhost:5173
RULES_PERSISTENCE_ENABLED=true
TICKS_PERSISTENCE_ENABLED=true
# Max distinct watched symbols (Finnhub free tier); a rule for a new symbol beyond it gets 409
WATCHLIST_MAX_SYMBOLS=50
RECONNECT_INITIAL_SECONDS=1.0
RECONNECT_MAX_SECONDS=30.0

# docker-compose (postgres service + frontend proxy)
POSTGRES_USER=postgres
POSTGRES_PASSWORD=your_db_password
POSTGRES_DB=ticks
VITE_BACKEND_URL=http://localhost:8000

# Tests only: pytest reads this from the shell environment, not from this file.
# Point it at a DISPOSABLE database; the real-Postgres tests drop their tables.
# TEST_DATABASE_URL=postgresql://postgres:your_db_password@127.0.0.1:5432/ticks_test
