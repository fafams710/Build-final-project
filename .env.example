# Copy to .env and fill in real values. Never commit .env.

# Your Finnhub API key (free tier): https://finnhub.io
FINNHUB_API_KEY=
DATABASE_URL=postgresql://postgres:your_db_password@localhost:5432/ticks
FINNHUB_WS_URL=wss://ws.finnhub.io
CORS_ORIGINS=http://localhost:5173
RULES_PERSISTENCE_ENABLED=true
TICKS_PERSISTENCE_ENABLED=true
RECONNECT_INITIAL_SECONDS=1.0
RECONNECT_MAX_SECONDS=30.0

# docker-compose (postgres service + frontend proxy)
POSTGRES_USER=postgres
POSTGRES_PASSWORD=your_db_password
POSTGRES_DB=ticks
VITE_BACKEND_URL=http://localhost:8000

# Tests only: pytest reads this from the shell environment, not from this file.
# Point it at a DISPOSABLE database; the real-Postgres tests drop their tables.
# TEST_DATABASE_URL=postgresql://postgres:your_db_password@localhost:5432/ticks_test
